#!/usr/bin/env python3
"""Block staged files over 10 MiB; never inspect or remove private files."""
import subprocess,sys
paths=subprocess.check_output(['git','diff','--cached','--name-only','--diff-filter=ACMR','-z']).split(b'\0')
failed=[]
for raw in filter(None,paths):
 path=raw.decode()
 size=int(subprocess.check_output(['git','cat-file','-s',':'+path]))
 if size>10*1024*1024:failed.append(path)
if failed:
 print('Commit blocked: staged files exceed 10 MiB:',*failed,sep='\n',file=sys.stderr)
 sys.exit(1)
